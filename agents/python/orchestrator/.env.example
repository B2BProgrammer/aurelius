# Conductor settings. Put these in the ROOT aurelius/.env (shared by all agents),
# or in agents/python/orchestrator/.env to override just for the Conductor.

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=replace-me
LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MOCK=true        # no API calls at all: fake planner + fake answer (free)

# --- Other agents ------------------------------------------------------------
# true  = Conductor uses built-in fake agents (use this until you build them)
# false = Conductor calls the real agents over HTTP
MOCK_AGENTS=true
# Agents listed here are called for REAL even when MOCK_AGENTS=true (comma-separated code IDs)
REAL_AGENTS=sentinel
# All 10 agents running?  MOCK_AGENTS=false  (or list them all in REAL_AGENTS)
# Mocks answer with REAL recorded agent output (src/agents/recorded_responses.json).
SERVICE_TOKEN=replace-with-long-random-string

# --- Security ----------------------------------------------------------------
AUTH_REQUIRED=true
JWT_SIGNING_KEY=replace-with-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # the Atrium web app (Vite)
# Dev sign-in for the web and mobile apps (stand-in for company SSO). Empty = disabled.
DEV_LOGIN_PASSWORD=pick-a-demo-password
# LOGIN_TOKEN_MINUTES=480            # how long an app sign-in lasts (8 hours)
# CONDUCTOR_HOST=127.0.0.1           # 0.0.0.0 ONLY to test the Flutter app on a real phone (Wi-Fi)
# If Sentinel is down: "closed" = refuse requests (safe), "open" = continue (risky)
SENTINEL_FAIL_MODE=closed
