# The Analyst reads aurelius\.env (shared). Override here only if needed.

SERVICE_TOKEN=replace-with-long-random-string          # same token everywhere

# Where the MCP server lives. Use 127.0.0.1 (not "localhost") on Windows.
MCP_ADVISOR_TOOLS_URL=http://127.0.0.1:8500/mcp

# Optional: Claude writes the summary and powers ask_portfolio
ANTHROPIC_API_KEY=replace-me
LLM_MODEL=claude-haiku-4-5-20251001
