# Sentinel reads aurelius\.env (shared by all agents). Only put a .env HERE
# if you want to override something just for Sentinel.

# Required: must be the SAME value the Conductor uses
SERVICE_TOKEN=replace-with-long-random-string

# Optional: enables the Claude Haiku classifier for borderline prompt injections
ANTHROPIC_API_KEY=replace-me
LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MOCK=true          # force rules-only even if a key is set

# Optional policy knobs
# SENTINEL_PORT=8004
# INJECTION_BLOCK_SCORE=0.8
# INJECTION_REVIEW_SCORE=0.4
# AUDIT_LOG_PATH=logs/audit.jsonl
