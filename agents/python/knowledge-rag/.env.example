# The Librarian reads aurelius\.env (shared). Only put a .env HERE to override for the Librarian.

# Required: same value the Conductor uses
SERVICE_TOKEN=replace-with-long-random-string

# Optional: Claude writes the answer. Without a key: extractive quotes (free)
ANTHROPIC_API_KEY=replace-me
LLM_MODEL=claude-haiku-4-5-20251001

# Embeddings: minilm (semantic, ~80 MB one-time download) | hash (offline, keyword-style)
EMBEDDING_PROVIDER=minilm

# Optional knobs
# LIBRARIAN_PORT=8001
# TOP_K=4
# MIN_SCORE=0.30
# CHUNK_SIZE=700
# CHUNK_OVERLAP=120
# DOCS_DIR=C:\path\to\your\documents
# CHROMA_DIR=C:\path\to\index
