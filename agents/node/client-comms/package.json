{
  "name": "aurelius-herald",
  "version": "0.1.0",
  "description": "Herald (client-comms): drafts client emails in the advisor's voice for the Aurelius swarm. TypeScript.",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/compose.test.ts tests/api.test.ts tests/openapi.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
