# The Herald reads aurelius\.env (shared). Put a .env HERE only to override for the Herald.
SERVICE_TOKEN=replace-with-long-random-string     # same token everywhere
ANTHROPIC_API_KEY=                                # empty or LLM_MOCK=true -> template drafts, no API cost
# LLM_MOCK=true
# LLM_MODEL=claude-haiku-4-5-20251001

# How you sign emails (\n = new line). The advisor still edits before sending.
# ADVISOR_SIGNATURE=Sam Rivera\nAurelius Wealth

# HERALD_PORT=8101
# HERALD_HOST=127.0.0.1
# LIAISON_URL=http://127.0.0.1:8102               # 127.0.0.1, not localhost (avoids IPv6 issues on Windows)
# LIAISON_TIMEOUT_MS=5000
# HERALD_AUDIT_FILE=C:\path\to\drafts.jsonl
# MAX_PURPOSE_CHARS=2000
# MAX_EMAIL_CHARS=10000
