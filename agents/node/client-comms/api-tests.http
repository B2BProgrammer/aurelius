###############################################################################
#  AURELIUS HERALD (client-comms, TypeScript) - API TEST COLLECTION
#
#  1. Start the LIAISON first (Terminal 1, crm-sync):    npm start   (port 8102)
#  2. Start the HERALD     (Terminal 2, client-comms):   npm start   (port 8101)
#     Swagger UI: http://localhost:8101/docs
#  3. Paste SERVICE_TOKEN from aurelius\.env:
#       Select-String -Path ..\..\..\.env -Pattern '^SERVICE_TOKEN='
#  4. Click "Send Request". Compare with EXPECT.
#  The Herald never sends email and never writes data: run these as often as you like.
###############################################################################

@baseUrl = http://localhost:8101
@serviceToken = PASTE-SERVICE-TOKEN-HERE


###############################################################################
#  1. PUBLIC
###############################################################################

### 1.1 Health. "mode" is "template" (no API key / LLM_MOCK=true) or "llm (claude-haiku-...)"
# EXPECT: 200  {"status":"ok","agent":"herald","mode":"...","liaison_url":"http://127.0.0.1:8102"}
GET {{baseUrl}}/health

### 1.2 Agent card: 2 skills + JSON schemas, depends_on liaison
# EXPECT: 200
GET {{baseUrl}}/.well-known/agent.json

### 1.3 OpenAPI 3.1 document (the Swagger page at /docs is built from it)
# EXPECT: 200  {"openapi":"3.1.0", ...}
GET {{baseUrl}}/openapi.json


###############################################################################
#  2. DRAFT_EMAIL (calls the Liaison for household details)
###############################################################################

### 2.1 Patel follow-up with points
# EXPECT: status ok, intent "meeting_follow_up", tone "brief" (Patels prefer short emails),
#         "Hi Raj and Anita,", both bullet points, advisor tasks, review date Thursday October 8,
#         to = masked emails, requires_approval true, warning "2 open task(s) are overdue"
# Then check the Liaison terminal: get_household with trace=http-2-1
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": {
    "client_id": "patel-001",
    "purpose": "Follow up on today's review meeting",
    "points": ["We agreed to increase the 529 contribution", "I'll send the updated plan by Friday"]
  },
  "context": { "trace_id": "http-2-1", "user_id": "dev-advisor" }
}

### 2.2 Chen: formal household that prefers PHONE
# EXPECT: intent "meeting_prep", tone "formal", "Dear Mr. and Mrs. Chen,", subject mentions the review date,
#         warnings: "Chen family prefers phone contact..."
#         (no points -> "[Add your key points]" placeholder + compliance warning, unless Claude is on)
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "client_id": "chen-002", "purpose": "Prepare for our upcoming review" },
  "context": { "trace_id": "http-2-2", "user_id": "dev-advisor" }
}

### 2.3 Override the tone
# EXPECT: tone "warm" -> "Hi Raj and Anita," + "Warm regards,"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "client_id": "patel-001", "purpose": "Thank them for the referral", "tone": "warm",
             "points": ["Thank you for introducing us to the Lees"] },
  "context": { "trace_id": "http-2-3", "user_id": "dev-advisor" }
}

### 2.4 COMPLIANCE: a promise and an account number in the points
# EXPECT: "guaranteed returns" -> "[removed: non-compliant claim]", 123456789 -> [ACCOUNT],
#         compliance.fixes ["CMP_GUARANTEE","PII_ACCOUNT"], disclosure_added true (risk text at the end),
#         warnings include Garcia's open service alert (late report)
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": {
    "client_id": "garcia-003",
    "purpose": "Check in about the new bond fund",
    "points": ["It offers guaranteed returns of 6%", "Your account 123456789 is set up"]
  },
  "context": { "trace_id": "http-2-4", "user_id": "dev-advisor" }
}

### 2.5 client_id from the context (how the Conductor sends it)
# EXPECT: status ok, salutation "Maria and Luis"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "purpose": "Schedule a call next week" },
  "context": { "trace_id": "http-2-5", "user_id": "dev-advisor", "client_id": "garcia-003" }
}


###############################################################################
#  3. REVIEW_EMAIL (an email the advisor wrote)
###############################################################################

### 3.1 Bad email: risk-free + certainty + SSN, to a phone-preferring household
# EXPECT: changed true, verdict "needs_edits", fixes CMP_NO_RISK, CMP_CERTAINTY, PII_SSN,
#         warning "Chen family prefers phone contact"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "review_email",
  "input": {
    "client_id": "chen-002",
    "text": "Hi Wei,\n\nThis fund is risk-free and will definitely go up. Your SSN 123-45-6789 is on file.\n\nBest,\nSam"
  },
  "context": { "trace_id": "http-3-1", "user_id": "dev-advisor" }
}

### 3.2 Clean email
# EXPECT: changed false, verdict "ready_for_approval", no fixes
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "review_email",
  "input": { "text": "Hi Maria and Luis,\n\nThanks for your time today. I'll send the paperwork tomorrow.\n\nBest,\nSam" },
  "context": { "trace_id": "http-3-2", "user_id": "dev-advisor" }
}

### 3.3 Performance talk -> disclosure added
# EXPECT: disclosure_added true, revised_text ends with "...do not guarantee future results."
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "review_email",
  "input": { "text": "Hi Raj and Anita,\n\nYour portfolio returns were strong this quarter.\n\nSam" },
  "context": { "trace_id": "http-3-3", "user_id": "dev-advisor" }
}

### 3.4 Wrong greeting for the household
# EXPECT: verdict "ready_for_approval" (nothing to fix) but warning "doesn't use the household's usual greeting"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "review_email",
  "input": { "client_id": "patel-001", "text": "Dear Sir or Madam,\n\nThanks for your time.\n\nSam" },
  "context": { "trace_id": "http-3-4", "user_id": "dev-advisor" }
}


###############################################################################
#  4. BROWSE
###############################################################################

### 4.1 Compliance rules every email goes through
# EXPECT: 200  [{"id":"CMP_GUARANTEE","action":"remove",...}, ... {"id":"PII_SSN","action":"mask"} ...]
GET {{baseUrl}}/v1/rules
Authorization: Bearer {{serviceToken}}


###############################################################################
#  5. ERRORS & SECURITY
###############################################################################

### 5.1 No token
# EXPECT: 401  {"detail":"Invalid or missing service token"}
POST {{baseUrl}}/invoke
Content-Type: application/json

{ "skill": "draft_email", "input": {}, "context": { "trace_id": "t", "user_id": "u" } }

### 5.2 Unknown client: an ERROR, not a generic email
# EXPECT: 200  status "error", error "No household with id 'nobody-1'"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "client_id": "nobody-1", "purpose": "hello there" },
  "context": { "trace_id": "http-5-2", "user_id": "dev-advisor" }
}

### 5.3 There is no send skill (by design)
# EXPECT: status "error", "unknown skill send_email"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "send_email", "input": {}, "context": { "trace_id": "http-5-3", "user_id": "dev-advisor" } }

### 5.4 Path-traversal style client_id
# EXPECT: status "error", "invalid input: client_id must be 1-64 letters..."
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "client_id": "../../etc", "purpose": "hello" },
  "context": { "trace_id": "http-5-4", "user_id": "dev-advisor" }
}

### 5.5 Missing context: breaks the contract
# EXPECT: 422  {"detail":"invalid input: context ..."}
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "draft_email", "input": { "client_id": "patel-001", "purpose": "hi there" } }

### 5.6 Not JSON
# EXPECT: 422  {"detail":"Body is not valid JSON"}
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{not json

### 5.7 STOP THE LIAISON (Ctrl+C in its terminal), then send this
# EXPECT: status ok (!), personalized false, "Hello,", warning "CRM unavailable ..." -> graceful degradation
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "skill": "draft_email",
  "input": { "client_id": "patel-001", "purpose": "Check in", "points": ["Hope the trip went well"] },
  "context": { "trace_id": "http-5-7", "user_id": "dev-advisor" }
}
