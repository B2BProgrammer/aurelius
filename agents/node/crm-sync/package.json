{
  "name": "aurelius-liaison",
  "version": "0.2.0",
  "description": "Liaison (crm-sync): CRM agent for the Aurelius swarm, in TypeScript. Households, notes, tasks.",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/api.test.ts tests/openapi.test.ts",
    "reset-data": "tsx scripts/reset-data.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
