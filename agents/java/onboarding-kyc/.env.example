# The Notary reads aurelius\.env (shared). Put a .env HERE only to override for the Notary.
SERVICE_TOKEN=replace-with-long-random-string     # same token everywhere

# NOTARY_PORT=8201
# NOTARY_HOST=127.0.0.1
# KYC_DATA_FILE=data/kyc.json                     # working copy (created from the seed on first start)
# KYC_SEED_FILE=data/kyc.seed.json
# KYC_WATCHLIST_FILE=data/watchlist.json          # FICTIONAL demo list
# KYC_AUDIT_FILE=logs/audit.jsonl
# KYC_EXPIRING_WINDOW_DAYS=60                     # "expiring soon" window for IDs
# KYC_MATCH_THRESHOLD=0.88                        # fuzzy-match score that counts as a potential match
