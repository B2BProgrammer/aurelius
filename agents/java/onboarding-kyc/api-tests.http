###############################################################################
#  AURELIUS NOTARY (onboarding-kyc, Java / Spring Boot) - API TEST COLLECTION
#
#  1. Start:  mvn spring-boot:run   (port 8201)   Swagger UI: http://localhost:8201/docs
#  2. Paste SERVICE_TOKEN from aurelius\.env:
#       Select-String -Path ..\..\..\.env -Pattern '^SERVICE_TOKEN='
#  3. Click "Send Request". Compare with EXPECT.
#  Writes change data\kyc.json. Start over: stop the server, delete data\kyc.json, start again.
###############################################################################

@baseUrl = http://localhost:8201
@serviceToken = PASTE-SERVICE-TOKEN-HERE


###############################################################################
#  1. PUBLIC
###############################################################################

### 1.1 Health
# EXPECT: 200  {"status":"ok","agent":"notary","clients":3,"watchlist_entries":5}
GET {{baseUrl}}/health

### 1.2 Agent card: 4 skills with "writes" flags and JSON schemas
# EXPECT: 200
GET {{baseUrl}}/.well-known/agent.json

### 1.3 OpenAPI document (generated by springdoc from the controllers)
# EXPECT: 200  {"openapi":"3.1.0" or "3.0.1", ... "paths": {"/invoke": ...}}
GET {{baseUrl}}/openapi.json


###############################################################################
#  2. CHECK_KYC (read)
###############################################################################

### 2.1 Patel: one action item
# EXPECT: status "action_needed", counts {blocker:0, action:1, info:2},
#         headline "1 action item. Raj Patel's driver's license expires on 2026-11-15 (in N days)."
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "patel-001" },
  "context": { "trace_id": "http-2-1", "user_id": "dev-advisor" } }

### 2.2 Chen: 65+ without trusted contacts, stale paperwork
# EXPECT: "action_needed", 5 actions: 2x KYC_TRUSTED_CONTACT_MISSING, AML_SCREENING_STALE (Lin),
#         KYC_ADDRESS_STALE, KYC_RISK_PROFILE_STALE
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "chen-002" },
  "context": { "trace_id": "http-2-2", "user_id": "dev-advisor" } }

### 2.3 Garcia: BLOCKED (Luis: no ID, never screened). Diego (17) has no issues of his own.
# EXPECT: "blocked", blockers KYC_ID_MISSING + AML_NOT_SCREENED, listed first
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "garcia-003" },
  "context": { "trace_id": "http-2-3", "user_id": "dev-advisor" } }

### 2.4 client_id in the CONTEXT (how the Conductor may send it)
# EXPECT: status ok, client_id "chen-002"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": {},
  "context": { "trace_id": "http-2-4", "user_id": "dev-advisor", "client_id": "chen-002" } }


###############################################################################
#  3. LIST_DOCUMENTS (read)
###############################################################################

### 3.1 Raj's documents: numbers masked
# EXPECT: D-1001 "number":"****4417", "state":"expiring"; the 2009 IRA beneficiary form
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "list_documents", "input": { "client_id": "patel-001", "member_id": "patel-001-m1" },
  "context": { "trace_id": "http-3-1", "user_id": "dev-advisor" } }


###############################################################################
#  4. SCREEN_NAME (AML watchlist, fuzzy match)
###############################################################################

### 4.1 Spelling variant of a (fictional) listed person
# EXPECT: "result":"potential_match", DEMO-0001, score ~0.97+, requires_review true,
#         note "... Do not tell the client about the screening."
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "screen_name", "input": { "name": "Victor Morozenko" },
  "context": { "trace_id": "http-4-1", "user_id": "dev-advisor" } }

### 4.2 Word order and accents don't fool it
# EXPECT: potential_match DEMO-0002
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "screen_name", "input": { "name": "Ruiz Villanueva Carlos" },
  "context": { "trace_id": "http-4-2", "user_id": "dev-advisor" } }

### 4.3 FALSE POSITIVE: "Luis Garcia" without a birth date looks like a listed alias
# EXPECT: potential_match DEMO-0004, reasons include "no date of birth to compare"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "screen_name", "input": { "name": "Luis Garcia" },
  "context": { "trace_id": "http-4-3", "user_id": "dev-advisor" } }

### 4.4 ... with his KYC file: DOB is taken from it -> clear, and recorded (WRITE)
# EXPECT: "result":"clear", "used_dob":true, "recorded_on":"garcia-003-m2"
#         Then run 2.3 again: AML_NOT_SCREENED is gone, KYC_ID_MISSING remains
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "screen_name", "input": { "name": "Luis Garcia", "client_id": "garcia-003", "member_id": "garcia-003-m2" },
  "context": { "trace_id": "http-4-4", "user_id": "dev-advisor" } }


###############################################################################
#  5. RECORD_DOCUMENT (write, idempotent)
###############################################################################

### 5.1 Raj's renewed license. Only the last 4 of the number are stored.
# EXPECT: "doc_id":"D-5001" (or next), "duplicate":false, document.number_last4 "8901",
#         "kyc_status_now":"complete"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "patel-001", "member_id": "patel-001-m1", "type": "GOVERNMENT_ID",
             "label": "Driver's license (renewed)", "number": "D123-4567-8901",
             "issued": "2026-10-01", "expires": "2034-10-01", "idempotency_key": "http-raj-license-2026" },
  "context": { "trace_id": "http-5-1", "user_id": "dev-advisor" } }

### 5.2 SEND 5.1 AGAIN (a retry): same doc_id, "duplicate": true, nothing new stored
#     (this one is identical to 5.1 on purpose)
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "patel-001", "member_id": "patel-001-m1", "type": "GOVERNMENT_ID",
             "label": "Driver's license (renewed)", "number": "D123-4567-8901",
             "issued": "2026-10-01", "expires": "2034-10-01", "idempotency_key": "http-raj-license-2026" },
  "context": { "trace_id": "http-5-2", "user_id": "dev-advisor" } }

### 5.3 Luis's passport -> Garcia goes from "blocked" to "action_needed" (if 4.4 ran)
# EXPECT: "kyc_status_now":"action_needed"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "garcia-003", "member_id": "garcia-003-m2", "type": "government_id",
             "label": "Mexican passport", "number": "G12345678", "issued": "2024-03-01", "expires": "2034-03-01" },
  "context": { "trace_id": "http-5-3", "user_id": "dev-advisor" } }

### 5.4 Maria's IRA beneficiary form (needs account_id)
# EXPECT: ok; KYC_BENEFICIARY_MISSING gone from garcia-003
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "garcia-003", "member_id": "garcia-003-m1", "type": "BENEFICIARY_DESIGNATION",
             "account_id": "GAR-MARIA-IRA", "issued": "2026-10-02" },
  "context": { "trace_id": "http-5-4", "user_id": "dev-advisor" } }


###############################################################################
#  6. BROWSE
###############################################################################

### 6.1 All households with status
# EXPECT: 200, 3 rows with status + headline
GET {{baseUrl}}/v1/clients
Authorization: Bearer {{serviceToken}}

### 6.2 One household (same as check_kyc)
GET {{baseUrl}}/v1/clients/garcia-003/kyc
Authorization: Bearer {{serviceToken}}

### 6.3 The rule book
# EXPECT: 200, 14 rules with severity
GET {{baseUrl}}/v1/rules
Authorization: Bearer {{serviceToken}}


###############################################################################
#  7. ERRORS & SECURITY
###############################################################################

### 7.1 No token
# EXPECT: 401  {"detail":"Invalid or missing service token"}, header WWW-Authenticate: Bearer
POST {{baseUrl}}/invoke
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "patel-001" }, "context": { "trace_id": "t", "user_id": "u" } }

### 7.2 Unknown client
# EXPECT: 200  status "error", "No KYC file for client 'nobody-1'"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "nobody-1" }, "context": { "trace_id": "http-7-2", "user_id": "dev-advisor" } }

### 7.3 Unknown skill
# EXPECT: status "error", "unknown skill open_account"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "open_account", "input": {}, "context": { "trace_id": "http-7-3", "user_id": "dev-advisor" } }

### 7.4 Validation: expires before issued
# EXPECT: status "error", "invalid input: expires must be after issued"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "patel-001", "member_id": "patel-001-m1", "type": "W9", "issued": "2026-01-01", "expires": "2025-01-01" },
  "context": { "trace_id": "http-7-4", "user_id": "dev-advisor" } }

### 7.5 Validation: unknown document type
# EXPECT: status "error", "invalid input: type must be one of [GOVERNMENT_ID, PROOF_OF_ADDRESS, W9, ...]"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "record_document",
  "input": { "client_id": "patel-001", "member_id": "patel-001-m1", "type": "passport", "issued": "2026-01-01" },
  "context": { "trace_id": "http-7-5", "user_id": "dev-advisor" } }

### 7.6 Path traversal style id
# EXPECT: status "error", "invalid input: client_id must be 1-64 letters, digits, '-' or '_'"
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "../../etc" }, "context": { "trace_id": "http-7-6", "user_id": "dev-advisor" } }

### 7.7 Name with SQL-ish characters
# EXPECT: status "error", "name may contain only letters, spaces, ..."
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "screen_name", "input": { "name": "Robert'); DROP TABLE--" }, "context": { "trace_id": "http-7-7", "user_id": "dev-advisor" } }

### 7.8 Missing context: breaks the contract
# EXPECT: 422  {"detail":"invalid request: context is required"}
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{ "skill": "check_kyc", "input": { "client_id": "patel-001" } }

### 7.9 Not JSON
# EXPECT: 422
POST {{baseUrl}}/invoke
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{not json

### 7.10 Unknown household on the REST view
# EXPECT: 404  {"detail":"No KYC file for client 'nobody-1'"}
GET {{baseUrl}}/v1/clients/nobody-1/kyc
Authorization: Bearer {{serviceToken}}

### 7.11 Unknown page
# EXPECT: 404  {"detail":"Not found"}
GET {{baseUrl}}/admin
