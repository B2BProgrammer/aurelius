# The Actuary reads aurelius\.env (shared). Put a .env HERE only to override for the Actuary.
SERVICE_TOKEN=replace-with-long-random-string     # same token everywhere (also used to call the MCP server)
MCP_ADVISOR_TOOLS_URL=http://127.0.0.1:8500/mcp   # same setting the Analyst uses

# ACTUARY_PORT=8202
# ACTUARY_HOST=127.0.0.1
# ACTUARY_MCP_TIMEOUT_MS=5000
# ACTUARY_DEFAULT_SIMULATIONS=5000                # futures simulated per projection
# ACTUARY_MAX_SIMULATIONS=20000                   # upper limit a caller may ask for (protects the CPU)
# ACTUARY_PROFILES_FILE=data/profiles.json
# ACTUARY_SNAPSHOT_FILE=data/portfolio-snapshot.json
