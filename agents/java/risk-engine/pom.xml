<?xml version="1.0" encoding="UTF-8"?>
<!--
  Actuary (risk-engine): risk and retirement math for the Aurelius swarm.

  LEARN: pom.xml is Maven's "package.json + tsconfig + build script" in one file.
    parent        -> Spring Boot's tested set of library versions (you don't pick each version)
    dependencies  -> what the code uses (downloaded into %USERPROFILE%\.m2 on first build)
    build/plugins -> spring-boot-maven-plugin: `mvn spring-boot:run` and the runnable jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.aurelius</groupId>
  <artifactId>actuary</artifactId>
  <version>0.1.0</version>
  <name>Aurelius Actuary (risk-engine)</name>
  <description>Risk and retirement agent: risk score, Monte Carlo retirement projection, stress tests</description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.8.9</springdoc.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Web server (Tomcat) + Spring MVC + Jackson (JSON) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Swagger UI at /docs, OpenAPI document at /openapi.json -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Tests: JUnit 5, Spring test support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>actuary</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
