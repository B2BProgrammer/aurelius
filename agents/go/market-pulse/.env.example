# Pulse reads aurelius\.env (shared). Put a .env HERE only to override for Pulse.
SERVICE_TOKEN=replace-with-long-random-string     # same token everywhere (also used to call the MCP server)
MCP_ADVISOR_TOOLS_URL=http://127.0.0.1:8500/mcp   # same setting as the Analyst and the Actuary

# PULSE_PORT=8301
# PULSE_HOST=127.0.0.1
# PULSE_MCP_TIMEOUT_MS=5000
# PULSE_DEFAULT_DAYS=14            # look-back window when a request doesn't say
# PULSE_MAX_SUBSCRIBERS=50         # live-stream connections allowed at once
# PULSE_SIMULATE_SECONDS=0         # e.g. 10 = publish a demo event every 10 s (for the live stream / UI)
# PULSE_AS_OF=2026-10-03           # freeze "today" so the demo events stay inside the 14-day window
# PULSE_EVENTS_FILE=data/events.json
# PULSE_SNAPSHOT_FILE=data/holdings-snapshot.json
# PULSE_SYMBOLS_FILE=data/symbols.json
