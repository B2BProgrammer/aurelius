<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Android blocks plain http:// by default (good).
  While developing, the Conductor runs on your own computer without HTTPS,
  so we allow http:// to these local addresses only. Release builds don't
  include this file, so they still require HTTPS everywhere.
  If you test on a real phone, add your computer's LAN IP below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
